PROJECT_NAME           = "mavlink-ground-station"
PROJECT_BRIEF          = "Lightweight MAVLink v2 ground control station in C++17"
OUTPUT_DIRECTORY       = build-docs
INPUT                  = README.md CHANGELOG.md CONTRIBUTING.md SECURITY.md include src apps
FILE_PATTERNS          = *.hpp *.cpp *.md
IMAGE_PATH             = docs
RECURSIVE              = YES
EXCLUDE                = src/crc_extra_table.hpp
USE_MDFILE_AS_MAINPAGE = README.md
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = NO
BUILTIN_STL_SUPPORT    = YES
SOURCE_BROWSER         = YES
GENERATE_HTML          = YES
GENERATE_LATEX         = NO
HAVE_DOT               = NO
QUIET                  = YES
WARN_IF_UNDOCUMENTED   = NO
WARN_AS_ERROR          = YES
